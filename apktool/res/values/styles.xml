<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AnimationFade">
        <item name="android:windowEnterAnimation">@anim/controler_up</item>
        <item name="android:windowExitAnimation">@anim/controler_down</item>
    </style>
    <style name="AnimationMenu">
        <item name="android:windowEnterAnimation">@anim/menu_fade_in</item>
        <item name="android:windowExitAnimation">@anim/menu_fade_out</item>
    </style>
    <style name="AnimationTimeFade">
        <item name="android:windowEnterAnimation">@anim/time_controler_down</item>
        <item name="android:windowExitAnimation">@anim/time_controler_up</item>
    </style>
    <style name="AppBaseTheme" parent="@android:style/Theme.Light" />
    <style name="AppTheme" parent="@style/AppBaseTheme" />
    <style name="Base.CardView" parent="@android:style/Widget">
        <item name="cardCornerRadius">@dimen/cardview_default_radius</item>
        <item name="cardElevation">@dimen/cardview_default_elevation</item>
        <item name="cardMaxElevation">@dimen/cardview_default_elevation</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">false</item>
    </style>
    <style name="CardView" parent="@style/Base.CardView" />
    <style name="CardView.Dark" parent="@style/CardView">
        <item name="cardBackgroundColor">@color/cardview_dark_background</item>
    </style>
    <style name="CardView.Light" parent="@style/CardView">
        <item name="cardBackgroundColor">@color/cardview_light_background</item>
    </style>
    <style name="CustomProgressStyle" parent="@android:style/Widget.ProgressBar.Large">
        <item name="android:maxWidth">@dimen/sm_120</item>
        <item name="android:maxHeight">@dimen/sm_120</item>
        <item name="android:minWidth">@dimen/sm_120</item>
        <item name="android:minHeight">@dimen/sm_120</item>
    </style>
    <style name="DialogAnim">
        <item name="android:windowEnterAnimation">@anim/dialog_fade_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_fade_out</item>
    </style>
    <style name="DialogStyle" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="Dialog_Fullscreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="Exitdialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="ExoMediaButton">
        <item name="android:background">?android:selectableItemBackground</item>
        <item name="android:layout_width">@dimen/exo_media_button_width</item>
        <item name="android:layout_height">@dimen/exo_media_button_height</item>
    </style>
    <style name="ExoMediaButton.FastForward" parent="@style/ExoMediaButton">
        <item name="android:src">@drawable/exo_controls_fastforward</item>
        <item name="android:contentDescription">@string/exo_controls_fastforward_description</item>
    </style>
    <style name="ExoMediaButton.Next" parent="@style/ExoMediaButton">
        <item name="android:src">@drawable/exo_controls_next</item>
        <item name="android:contentDescription">@string/exo_controls_next_description</item>
    </style>
    <style name="ExoMediaButton.Pause" parent="@style/ExoMediaButton">
        <item name="android:src">@drawable/exo_controls_pause</item>
        <item name="android:contentDescription">@string/exo_controls_pause_description</item>
    </style>
    <style name="ExoMediaButton.Play" parent="@style/ExoMediaButton">
        <item name="android:src">@drawable/exo_controls_play</item>
        <item name="android:contentDescription">@string/exo_controls_play_description</item>
    </style>
    <style name="ExoMediaButton.Previous" parent="@style/ExoMediaButton">
        <item name="android:src">@drawable/exo_controls_previous</item>
        <item name="android:contentDescription">@string/exo_controls_previous_description</item>
    </style>
    <style name="ExoMediaButton.Rewind" parent="@style/ExoMediaButton">
        <item name="android:src">@drawable/exo_controls_rewind</item>
        <item name="android:contentDescription">@string/exo_controls_rewind_description</item>
    </style>
    <style name="ExoMediaButton.Shuffle" parent="@style/ExoMediaButton">
        <item name="android:src">@drawable/exo_controls_shuffle</item>
        <item name="android:contentDescription">@string/exo_controls_shuffle_description</item>
    </style>
    <style name="MyCheckBox" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:button">@drawable/check_selector</item>
    </style>
    <style name="TextAppearance.Compat.Notification" parent="@android:style/TextAppearance.StatusBar.EventContent" />
    <style name="TextAppearance.Compat.Notification.Info" parent="@style/TextAppearance.Compat.Notification">
        <item name="android:textSize">12.0sp</item>
        <item name="android:textColor">?android:textColorSecondary</item>
    </style>
    <style name="TextAppearance.Compat.Notification.Info.Media" parent="@style/TextAppearance.Compat.Notification.Info" />
    <style name="TextAppearance.Compat.Notification.Line2" parent="@style/TextAppearance.Compat.Notification.Info" />
    <style name="TextAppearance.Compat.Notification.Line2.Media" parent="@style/TextAppearance.Compat.Notification.Info.Media" />
    <style name="TextAppearance.Compat.Notification.Media" parent="@style/TextAppearance.Compat.Notification" />
    <style name="TextAppearance.Compat.Notification.Time" parent="@style/TextAppearance.Compat.Notification">
        <item name="android:textSize">12.0sp</item>
        <item name="android:textColor">?android:textColorSecondary</item>
    </style>
    <style name="TextAppearance.Compat.Notification.Time.Media" parent="@style/TextAppearance.Compat.Notification.Time" />
    <style name="TextAppearance.Compat.Notification.Title" parent="@android:style/TextAppearance.StatusBar.EventContent.Title" />
    <style name="TextAppearance.Compat.Notification.Title.Media" parent="@style/TextAppearance.Compat.Notification.Title" />
    <style name="TitleButton">
        <item name="android:textSize">@dimen/sm_28</item>
        <item name="android:textColor">@drawable/title_textcolor_selector</item>
        <item name="android:textColorHighlight">@color/white</item>
        <item name="android:background">@drawable/title_button_selector</item>
    </style>
    <style name="WiFiDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="Widget.Compat.NotificationActionContainer" parent="" />
    <style name="Widget.Compat.NotificationActionText" parent="" />
    <style name="Widget.Support.CoordinatorLayout" parent="@android:style/Widget">
        <item name="statusBarBackground">#ff000000</item>
    </style>
    <style name="bottom_TitleButton">
        <item name="android:textSize">@dimen/sm_24</item>
    </style>
    <style name="home_bottom_LinearLayout">
        <item name="android:gravity">left|center</item>
        <item name="android:background">@drawable/home_bottom_item_bg</item>
        <item name="android:paddingLeft">@dimen/sm_50</item>
        <item name="android:paddingRight">@dimen/sm_25</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/sm_60</item>
        <item name="android:layout_marginRight">@dimen/sm_25</item>
    </style>
    <style name="home_top_LinearLayout">
        <item name="android:gravity">left|center</item>
        <item name="android:background">@drawable/home_top_button_bg</item>
        <item name="android:paddingLeft">@dimen/sm_25</item>
        <item name="android:paddingRight">@dimen/sm_25</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/sm_54</item>
    </style>
    <style name="home_top_LinearLayouts">
        <item name="android:gravity">left|center</item>
        <item name="android:background">@drawable/home_top_button_bg</item>
        <item name="android:paddingLeft">@dimen/sm_25</item>
        <item name="android:paddingRight">@dimen/sm_25</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/sm_54</item>
    </style>
    <style name="marqueeText">
        <item name="android:ellipsize">marquee</item>
        <item name="android:gravity">center</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
    </style>
    <style name="search_keybord_full">
        <item name="android:textSize">@dimen/sm_28</item>
        <item name="android:textColor">@drawable/menu_textcolor_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/keypad_button_selector</item>
        <item name="android:layout_width">@dimen/sm_60</item>
        <item name="android:layout_height">@dimen/sm_60</item>
        <item name="android:layout_margin">@dimen/sm_3</item>
        <item name="android:onClick">doClick</item>
    </style>
    <style name="search_keybord_fulls">
        <item name="android:textSize">@dimen/sm_28</item>
        <item name="android:textColor">@drawable/menu_textcolor_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/keypad_button_selector</item>
        <item name="android:layout_width">@dimen/sm_325</item>
        <item name="android:layout_height">@dimen/sm_60</item>
        <item name="android:layout_margin">@dimen/sm_3</item>
        <item name="android:onClick">doClick</item>
    </style>
    <style name="search_keybord_t9">
        <item name="android:layout_width">@dimen/sm_60</item>
        <item name="android:layout_height">@dimen/sm_60</item>
        <item name="android:layout_margin">@dimen/sm_3</item>
        <item name="android:onClick">doClick</item>
    </style>
    <style name="user_leftbar_full">
        <item name="android:textSize">@dimen/sm_28</item>
        <item name="android:textColor">@drawable/member_textcolor_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/button_focus</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_width">@dimen/sm_199</item>
        <item name="android:layout_height">@dimen/sm_80</item>
        <item name="android:layout_centerHorizontal">true</item>
    </style>
    <style name="vip_item_message">
        <item name="android:textSize">@dimen/sm_14</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="vip_item_price">
        <item name="android:textSize">@dimen/sm_25</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffa000</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/sm_10</item>
        <item name="android:layout_marginRight">@dimen/sm_100</item>
        <item name="android:layout_centerVertical">true</item>
    </style>
    <style name="vip_item_root">
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_input2</item>
        <item name="android:padding">@dimen/sm_3</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/sm_1</item>
    </style>
    <style name="vip_item_title">
        <item name="android:textSize">@dimen/sm_30</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/sm_10</item>
    </style>
</resources>
